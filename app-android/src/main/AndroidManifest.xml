<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />
    <!-- Only while an OGS sign-in waits for the browser: keeps Android from freezing the app
         while its loopback listener is supposed to answer the redirect. Granted without a
         prompt; see SignInKeepAwakeService. -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <!-- "Your move" and "Time running low", only once the user switches them on in Settings
         (asked for there, Android 13+). WorkManager adds ACCESS_NETWORK_STATE, WAKE_LOCK and
         RECEIVE_BOOT_COMPLETED for the background check itself. -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <application
        android:name=".TurnzenApplication"
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.Turnzen"
        android:usesCleartextTraffic="false">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <!-- The "Back to Turnzen" link on the page shown after an OGS sign-in. A browser
                 opens an app from a link only when the app says it can be browsed to; it
                 carries nothing, it only brings the app back. singleTask, so the return
                 closes the browser page the sign-in left in Turnzen's task instead of
                 stacking a second copy of the app on top of it. -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data
                    android:host="signed-in"
                    android:scheme="turnzen" />
            </intent-filter>
        </activity>

        <service
            android:name=".signin.SignInKeepAwakeService"
            android:exported="false"
            android:foregroundServiceType="shortService" />
    </application>
</manifest>
